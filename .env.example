# ---------------------------------------------------------------------------
# Navis — copia este fichero a `.env` y ajusta los valores.
# `.env` está en .gitignore: nunca subas secretos al repositorio.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Base de datos ----------------------------------------------------------
# Dos modos, y se cambia solo con esta variable:
#   sqlite   → base de datos LOCAL en un fichero. Es el valor por defecto:
#              no necesitas Docker ni servidor para arrancar el proyecto.
#   postgres → base de datos COMPARTIDA. Pon aquí las credenciales del
#              servidor y todas las apps (web, móvil, escritorio) trabajarán
#              contra los mismos datos.
DB_DRIVER=sqlite

# Solo para DB_DRIVER=sqlite. Ruta relativa a la raíz del monorepo.
DB_SQLITE_PATH=./data/navis.sqlite

# Solo para DB_DRIVER=postgres
POSTGRES_USER=navis
POSTGRES_PASSWORD=navis_dev
POSTGRES_DB=navis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Usada por el contenedor de la API (dentro de la red de Docker el host es "postgres")
DATABASE_URL=postgresql://navis:navis_dev@localhost:5432/navis

# --- API --------------------------------------------------------------------
API_PORT=3000
API_PREFIX=api
API_VERSION=1
# Orígenes permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Autenticación: Better Auth (sesiones guardadas en Postgres) ------------
# Genera el secreto con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=cambia-esto-en-produccion-minimo-32-caracteres
BETTER_AUTH_URL=http://localhost:3000
# Orígenes de confianza (web + deep link de la app móvil), separados por comas
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8081,navis://
SESSION_EXPIRES_IN_DAYS=30

# Actívalo SOLO si la API va detrás de un proxy (nginx, Traefik, Cloudflare):
# hace que el limitador de peticiones use la IP real del cliente.
TRUST_PROXY=false

# --- Observabilidad ---------------------------------------------------------
LOG_LEVEL=debug

# --- IA (desactivada por defecto; ver docs/adr/0002) ------------------------
AI_ENABLED=false
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# URL del microservicio Python opcional (perfil `ai` de docker compose)
AI_SERVICE_URL=http://localhost:8000

# --- Clientes ---------------------------------------------------------------
# Web (Vite lee este mismo fichero: envDir apunta a la raíz del monorepo)
VITE_API_URL=http://localhost:3000/api/v1
VITE_AUTH_URL=http://localhost:3000

# Móvil (Expo). En un dispositivo físico usa la IP de tu equipo, no localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_AUTH_URL=http://localhost:3000
EXPO_PUBLIC_APP_SCHEME=navis
