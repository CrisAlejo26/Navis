{
  "name": "@pastortools/i18n",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Traducciones compartidas (es, en, fr, pt, de, it) e instancia de i18next para web y móvil",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@pastortools/shared": "workspace:*"
  },
  "peerDependencies": {
    "i18next": ">=26",
    "react": ">=19",
    "react-i18next": ">=17"
  },
  "devDependencies": {
    "@pastortools/eslint-config": "workspace:*",
    "@pastortools/tsconfig": "workspace:*",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "eslint": "10.8.0",
    "i18next": "26.3.6",
    "react": "19.2.8",
    "react-i18next": "17.0.11",
    "rimraf": "6.1.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
