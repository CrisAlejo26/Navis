{
  "name": "@fidus/theme",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Tokens de diseño Tailwind v4 y store de tema (light/dark/system) compartidos por web y móvil",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./tokens.native.css": "./src/tokens.native.css"
  },
  "files": [
    "dist",
    "src/tokens.css",
    "src/tokens.native.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@fidus/shared": "workspace:*"
  },
  "peerDependencies": {
    "zustand": ">=5"
  },
  "devDependencies": {
    "@fidus/eslint-config": "workspace:*",
    "@fidus/tsconfig": "workspace:*",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "rimraf": "6.1.3",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zustand": "catalog:"
  }
}
