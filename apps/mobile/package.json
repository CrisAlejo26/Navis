    "@types/react": "19.2.18",
    "eslint": "10.8.0",
    "expo-doctor": "1.20.1",
    "jest": "29.7.0",
    "jest-expo": "57.0.4",
    "lightningcss": "1.30.1",
    "rimraf": "6.1.3",
    "tailwindcss": "catalog:",
    "test-renderer": "1.2.0",
    "typescript": "catalog:"
