    "@navis/i18n": "workspace:*",
    "@navis/shared": "workspace:*",
    "@navis/theme": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "catalog:",
    "better-auth": "1.6.25",
    "clsx": "2.1.1",
    "expo": "57.0.14",
    "expo-constants": "57.0.12",
    "expo-font": "~57.0.1",
    "expo-linking": "57.0.6",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-router": "57.0.14",
