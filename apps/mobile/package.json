{
  "name": "@navis/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "App móvil de Navis (Expo 57 + expo-router + NativeWind 5)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
