{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fidus",
  "version": "0.1.0",
  "identifier": "org.fidus.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @fidus/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @fidus/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fidus",
        "width": 1280,
        "height": 800,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "theme": null,
        "backgroundColor": "#fcfcfa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Herramientas para pastores e iglesias",
    "longDescription": "Agenda, creyentes, profecías, sueños y comunicaciones para el trabajo pastoral.",
    "copyright": "© Fidus — MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
