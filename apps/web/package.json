{
  "name": "@navis/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "PWA de Navis (Vite 8 + React 19 + React Router 8)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "pwa-assets": "pwa-assets-generator",
    "clean": "rimraf dist dev-dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@navis/api-client": "workspace:*",
    "@navis/i18n": "workspace:*",
    "@navis/shared": "workspace:*",
    "@navis/theme": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "better-auth": "1.6.25",
    "clsx": "2.1.1",
    "i18next": "26.3.6",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "react-i18next": "17.0.11",
    "react-router": "8.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "3.6.0",
    "unicode-emoji-json": "^0.9.0",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@hookform/resolvers": "5.7.1",
    "@navis/eslint-config": "workspace:*",
    "@navis/tsconfig": "workspace:*",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "10.8.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "rimraf": "6.1.3",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "catalog:",
    "workbox-window": "7.4.1"
  }
}
