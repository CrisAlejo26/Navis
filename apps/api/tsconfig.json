{
  "extends": "@navis/tsconfig/nest.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "*.config.ts",
    "*.config.mts",
    "vitest.setup.ts",
    "vitest.e2e.setup.ts",
    "scripts/**/*"
  ],
  // `src/metadata.ts` lo genera el plugin de Swagger en cada build y no lo
  // importa nadie. Comprobarlo no aporta nada y, con `nest start --watch`
  // corriendo, `pnpm typecheck` lo pillaba a medio escribir y fallaba con
  // errores de sintaxis en un fichero que nadie había tocado.
  "exclude": ["node_modules", "dist", "src/metadata.ts"]
}
