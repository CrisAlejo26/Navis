{
  "extends": "@navis/tsconfig/nest.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "*.config.ts",
    "*.config.mts",
    "vitest.setup.ts",
    "scripts/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
