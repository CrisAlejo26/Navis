{
  "name": "@pastortools/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "API de PastorTools (NestJS 11 + TypeORM 1 + Better Auth)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch --builder swc",
    "build": "nest build --builder swc",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typeorm": "node --import tsx ./node_modules/typeorm/cli.js -d ./src/database/data-source.ts",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "migration:show": "pnpm typeorm migration:show",
    "migration:generate": "pnpm typeorm migration:generate ./src/database/migrations/Auto",
    "migration:create": "node --import tsx ./node_modules/typeorm/cli.js migration:create ./src/database/migrations/Manual",
    "auth:generate": "better-auth generate --config ./src/auth/auth.ts --output ./src/database/better-auth.sql -y",
    "auth:migrate": "better-auth migrate --config ./src/auth/auth.ts -y",
    "seed": "node --import tsx ./src/database/seeds/seed.ts",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@better-auth/expo": "1.6.25",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.3",
    "@pastortools/shared": "workspace:*",
    "better-auth": "1.6.25",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "nestjs-pino": "4.6.1",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@pastortools/eslint-config": "workspace:*",
    "@pastortools/tsconfig": "workspace:*",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.47",
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.3",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "10.8.0",
    "pino-pretty": "13.1.3",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "tsx": "4.23.4",
    "typescript": "catalog:",
    "unplugin-swc": "1.5.9",
    "vitest": "catalog:"
  }
}
