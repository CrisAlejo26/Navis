# Metro (Expo) no resuelve el store aislado de pnpm dentro de un monorepo.
# Con hoisted, apps/mobile encuentra sus dependencias nativas sin symlinks.
node-linker=hoisted

# NO actives inject-workspace-packages: copia los paquetes del workspace en vez
# de enlazarlos, congelando su `dist` en el momento del install. En los
# Dockerfiles se usa `pnpm deploy --legacy`, que no lo necesita.

auto-install-peers=true
strict-peer-dependencies=false
resolution-mode=highest
prefer-workspace-packages=true
link-workspace-packages=true
